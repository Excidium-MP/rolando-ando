# Supabase. EXPO_PUBLIC_ vars ship in the JS bundle, so treat them as public.
# Get these from your Supabase project: Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (service role keys, etc.) NEVER go here.
# Put those in Supabase Edge Functions or EAS Secrets.
